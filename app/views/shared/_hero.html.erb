<section class="pt-16 pb-24">
  <div class="max-w-2xl">
    <p class="text-sm uppercase tracking-[0.2em] text-emerald-400 mb-6">Concert Agenda</p>
    <h1 class="text-5xl sm:text-6xl font-black tracking-tight leading-[1.05]"
        style="font-family: 'Fraunces', serif;">
      Alleen de shows die
      <span class="italic text-emerald-300">jij</span>
      wilt zien.
    </h1>
    <p class="mt-6 text-lg text-neutral-400 max-w-lg">
      Log in met Spotify — wij houden bij welke artiesten uit jouw luistergeschiedenis
      binnenkort in Nederland spelen.
    </p>
    <div class="mt-10">
      <%= button_to spotify_login_path, method: :post,
            data: { turbo: false },
            form: { class: "inline" },
            class: "inline-flex items-center gap-2 bg-emerald-400 hover:bg-emerald-300
                    text-neutral-950 font-semibold px-6 py-3 rounded-full transition" do %>
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14 4.38-1.32 9.78-.66 13.5 1.62.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z"/>
        </svg>
        Inloggen met Spotify
      <% end %>
    </div>
    <p class="mt-6 text-xs text-neutral-500">
      We lezen alleen je top-artiesten en gevolgden. Geen posts, geen playlists.
    </p>
  </div>
</section>
