<% has_spotify = artist.spotify_id.present? && !artist.spotify_id.start_with?("manual:") %>
<li id="top_artist_<%= artist.spotify_id %>"
    class="group relative rounded-xl overflow-hidden bg-white/[0.03] border border-white/5 hover:border-white/15 transition">
  <%= link_to(
        (has_spotify ? "https://open.spotify.com/artist/#{artist.spotify_id}" : "#"),
        target: (has_spotify ? "_blank" : nil), rel: "noopener",
        class: "block #{'pointer-events-none' unless has_spotify}") do %>
    <div class="relative aspect-square overflow-hidden">
      <% if artist.image_url.present? %>
        <%= image_tag artist.image_url,
              class: "w-full h-full object-cover group-hover:scale-105 transition duration-500" %>
      <% else %>
        <div class="w-full h-full bg-neutral-800"></div>
      <% end %>
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-black/0"></div>
      <% if artist.best_rank && artist.best_rank <= 50 %>
        <span class="absolute top-2 left-2 text-[11px] font-medium px-1.5 py-0.5 rounded bg-black/60 text-neutral-300 tabular-nums">
          #<%= artist.best_rank %>
        </span>
      <% end %>
    </div>
    <div class="p-3">
      <div class="font-medium truncate leading-tight"><%= artist.name %></div>
    </div>
  <% end %>

  <% if artist.manual? %>
    <%= button_to artist_path(artist),
          method: :delete,
          form: { class: "absolute top-2 right-2 z-10" },
          class: "opacity-0 group-hover:opacity-100 transition
                  text-[11px] px-2 py-1 rounded-full
                  bg-black/70 hover:bg-black/90 text-neutral-200
                  border border-white/10",
          title: "Verwijder #{artist.name}" do %>
      Verwijder
    <% end %>
    <span class="absolute top-2 left-2 z-10 text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded
                 bg-emerald-400/15 text-emerald-200 border border-emerald-400/30">
      Handmatig
    </span>
  <% else %>
    <%= button_to hidden_artists_path(
            spotify_artist_id: artist.spotify_id,
            name: artist.name,
            image_url: artist.image_url
          ),
          method: :post,
          form: { class: "absolute top-2 right-2 z-10" },
          class: "opacity-0 group-hover:opacity-100 transition
                  text-[11px] px-2 py-1 rounded-full
                  bg-black/70 hover:bg-black/90 text-neutral-200
                  border border-white/10",
          title: "Verberg #{artist.name}" do %>
      Verberg
    <% end %>
  <% end %>

  <% if has_spotify %>
  <details class="px-3 pb-3 -mt-1 group/details">
    <summary class="cursor-pointer text-xs text-neutral-500 hover:text-neutral-300 select-none list-none flex items-center gap-1">
      <svg viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 transition group-open/details:rotate-180" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 0 1 1.08 1.04l-4.25 4.4a.75.75 0 0 1-1.08 0l-4.25-4.4a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd"/>
      </svg>
      Populair
    </summary>
    <turbo-frame id="tracks_<%= artist.spotify_id %>"
                 src="<%= spotify_artist_top_tracks_path(spotify_id: artist.spotify_id) %>"
                 loading="lazy">
      <p class="mt-2 text-xs text-neutral-600">Laden…</p>
    </turbo-frame>
  </details>
  <% end %>
</li>
